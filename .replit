[nix]
channel = "stable-25_05"
packages = ["nodejs_22", "unzip"]

[run]
command = "cd shibbolethv1-claude-shibboleth-bias-detector-fUJhN && npm run dev"

[deployment]
run = ["sh", "-c", "cd shibbolethv1-claude-shibboleth-bias-detector-fUJhN && npm start"]
build = ["sh", "-c", "cd shibbolethv1-claude-shibboleth-bias-detector-fUJhN && npm install && npm run build"]
deploymentTarget = "cloudrun"

[agent]
expertMode = true

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Next.js Dev Server"

[[workflows.workflow]]
name = "Next.js Dev Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd shibbolethv1-claude-shibboleth-bias-detector-fUJhN && npm run dev -- -p 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
